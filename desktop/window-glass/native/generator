#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# This exact template starts the Ubuntu session with the following command.
# Leave package updates and administrator-provided templates to systemd.
set -eu
unit=org.gnome.Shell@.service
stock=/usr/lib/systemd/user/$unit
# An explicit unit-path policy belongs to the administrator.
[ -z "${SYSTEMD_UNIT_PATH:-}" ] || exit 0
for dir in "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user.control" \
           "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/user.control" \
           "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/transient" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" /etc/systemd/user \
           "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/user" /run/systemd/user \
           "${XDG_DATA_HOME:-$HOME/.local/share}/systemd/user" \
           /usr/local/share/systemd/user /usr/share/systemd/user /usr/local/lib/systemd/user \
           /usr/lib/systemd/user; do
    for name in "$unit" org.gnome.Shell@ubuntu.service; do
        if [ "$dir/$name" != "$stock" ] && { [ -e "$dir/$name" ] || [ -L "$dir/$name" ]; }; then exit 0; fi
        for conf in "$dir/$name.d/"*.conf; do
            if [ -f "$conf" ] && grep -Eq '^[[:space:]]*ExecStart[[:space:]]*=' "$conf"; then exit 0; fi
        done
    done
done
[ -r "$stock" ] || exit 0
actual=$(/usr/bin/sha256sum "$stock") || exit 0
[ "${actual%% *}" = 1cdbe302402ba2ef4e740ccdd41be7dda0b781c060699c4ebae89e241ef86afe ] || exit 0
dir=$1/org.gnome.Shell@ubuntu.service.d
mkdir -p "$dir"
cat > "$dir/00-norvi-window-glass.conf" <<'UNIT'
[Service]
ExecStart=
ExecStart=:/bin/sh -c 'if test -x /usr/libexec/norvi-window-glass/compatible && /usr/libexec/norvi-window-glass/compatible "$@"; then export NORVI_WINDOW_GLASS_LAUNCH_PID=$$ LD_AUDIT=/usr/lib/x86_64-linux-gnu/norvi-window-glass/loader-audit.so; fi; exec /usr/bin/gnome-shell "$@"' sh --mode=ubuntu
UNIT
