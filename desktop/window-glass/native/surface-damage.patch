+/* State is applied as a transaction. Using a protocol request or the final
+ * stage redraw clip here would lose that commit's coordinate frame. */
+static gboolean
+damage_mapping_changed (MetaWaylandSurfaceState *state)
+{
+  return state->dx || state->dy || state->derived.surface_size_changed ||
+         state->scale > 0 || state->has_new_buffer_transform ||
+         state->has_new_viewport_src_rect || state->has_new_viewport_dst_size ||
+         state->has_new_geometry || state->subsurface_placement_ops ||
+         state->opaque_region_set || state->has_new_color_state ||
+         state->has_new_premult || state->has_new_coeffs ||
+         state->has_new_chroma_loc;
+}
+
+/* A buffer swap normally keeps its visual representation. A swap between
+ * different representations can change the full image regardless of damage. */
+static gboolean
+buffer_mapping_changed (MetaWaylandSurface      *surface,
+                        MetaWaylandSurfaceState *state)
+{
+  if (!state->newly_attached)
+    return FALSE;
+
+  if (!surface->buffer || !state->buffer ||
+      !surface->applied_state.texture || !state->texture)
+    return TRUE;
+
+  return surface->buffer->type != state->buffer->type ||
+         meta_wayland_buffer_is_y_inverted (surface->buffer) !=
+         meta_wayland_buffer_is_y_inverted (state->buffer) ||
+         meta_multi_texture_get_width (surface->applied_state.texture) !=
+         meta_multi_texture_get_width (state->texture) ||
+         meta_multi_texture_get_height (surface->applied_state.texture) !=
+         meta_multi_texture_get_height (state->texture) ||
+         meta_multi_texture_get_format (surface->applied_state.texture) !=
+         meta_multi_texture_get_format (state->texture) ||
+         cogl_texture_get_format (meta_multi_texture_get_plane (surface->applied_state.texture, 0)) !=
+         cogl_texture_get_format (meta_multi_texture_get_plane (state->texture, 0));
+}
+
+static gboolean
+get_toplevel_damage_bounds (MetaWaylandSurface      *surface,
+                            MetaWaylandSurfaceState *state,
+                            MetaWindowActor         *window_actor,
+                            MtkRectangle            *bounds)
+{
+  MetaSurfaceActor *surface_actor;
+  ClutterActor *actor, *stage, *ancestor;
+  MetaShapedTexture *texture;
+  MtkRectangle box, damage, clip, frame;
+  graphene_point3d_t v[4] = { 0 };
+  ClutterActorBox content;
+  float width, height;
+  gboolean reached_window = FALSE;
+
+  if (surface->applied_state.scale != 1 ||
+      surface->buffer_transform != MTK_MONITOR_TRANSFORM_NORMAL ||
+      surface->viewport.has_src_rect || surface->viewport.has_dst_size ||
+      meta_wayland_surface_get_toplevel (surface) != surface ||
+      meta_wayland_surface_is_xwayland (surface) ||
+      meta_window_actor_effect_in_progress (window_actor) ||
+      mtk_region_is_empty (state->buffer_damage))
+    return FALSE;
+
+  surface_actor = meta_wayland_surface_get_actor (surface);
+  if (!surface_actor || meta_surface_actor_is_frozen (surface_actor))
+    return FALSE;
+
+  actor = CLUTTER_ACTOR (surface_actor);
+  stage = clutter_actor_get_stage (actor);
+  if (!stage || !clutter_actor_is_mapped (actor))
+    return FALSE;
+
+  /* The stage is the root and has no parent allocation. All descendants
+   * must already be allocated; querying vertices must not force a layout. */
+  for (ancestor = actor; ancestor && ancestor != stage;
+       ancestor = clutter_actor_get_parent (ancestor))
+    {
+      if (ancestor == CLUTTER_ACTOR (window_actor))
+        reached_window = TRUE;
+      /* The consumer can inspect the window actor and its parents. Only
+       * Mutter can see the originating surface inside it. An effect there
+       * may expand damage beyond the projected buffer rectangle. */
+      if (!clutter_actor_has_allocation (ancestor) ||
+          clutter_actor_has_mapped_clones (ancestor) ||
+          (!reached_window && clutter_actor_has_effects (ancestor)))
+        return FALSE;
+    }
+  if (!reached_window || ancestor != stage)
+    return FALSE;
+
+  /* A stable one-to-one root surface is the initial supported case. For a
+   * transformed actor, a sub-surface, a clone or any uncertain mapping the
+   * consumer receives NULL and refreshes its usual set of dependents. */
+  meta_window_get_buffer_rect (meta_window_actor_get_meta_window (window_actor), &box);
+  texture = meta_surface_actor_get_texture (surface_actor);
+  clutter_actor_get_size (actor, &width, &height);
+  clutter_actor_get_content_box (actor, &content);
+  if (width != box.width || height != box.height ||
+      content.x1 != 0 || content.y1 != 0 ||
+      content.x2 != width || content.y2 != height ||
+      meta_shaped_texture_get_width (texture) != width ||
+      meta_shaped_texture_get_height (texture) != height)
+    return FALSE;
+
+  clutter_actor_get_abs_allocation_vertices (actor, v);
+  for (unsigned int i = 0; i < G_N_ELEMENTS (v); i++)
+    {
+      float x = box.x + (i % 2 ? width : 0);
+      float y = box.y + (i / 2 ? height : 0);
+      /* Require a unit translation. Negated comparisons reject NaNs. The
+       * one-pixel guard below covers projection rounding at the edges. */
+      if (!(fabsf (v[i].x - x) < 0.01f &&
+            fabsf (v[i].y - y) < 0.01f &&
+            fabsf (v[i].z - v[0].z) < 0.01f))
+        return FALSE;
+    }
+
+  damage = mtk_region_get_extents (state->buffer_damage);
+  if (!meta_shaped_texture_get_damage_clip (texture, &damage, &clip) ||
+      clip.width <= 0 || clip.height <= 0)
+    return FALSE;
+
+  *bounds = (MtkRectangle) { box.x + clip.x - 1, box.y + clip.y - 1,
+                             clip.width + 2, clip.height + 2 };
+  /* The extension indexes ordinary sources by their frame. Client-side
+   * shadow buffers can extend beyond it and use the unbounded event. */
+  meta_window_get_frame_rect (meta_window_actor_get_meta_window (window_actor), &frame);
+  return mtk_rectangle_contains_rect (&frame, bounds);
+}
+
 void
 meta_wayland_surface_apply_state (MetaWaylandSurface      *surface,
                                   MetaWaylandSurfaceState *state)
 {
   gboolean had_damage = FALSE;
+  gboolean mapping_changed;
   int old_width, old_height;
 
   old_width = meta_wayland_surface_get_width (surface);
   old_height = meta_wayland_surface_get_height (surface);
 
+  mapping_changed = buffer_mapping_changed (surface, state);
   g_signal_emit (surface, surface_signals[SURFACE_PRE_STATE_APPLIED], 0);
 
   surface->applied_state.is_valid = surface->committed_state.is_valid;
@@ -987,6 +1122,8 @@ meta_wayland_surface_apply_state (MetaWaylandSurface      *surface,
     meta_wayland_surface_get_width (surface) != old_width ||
     meta_wayland_surface_get_height (surface) != old_height;
 
+  mapping_changed |= damage_mapping_changed (state);
+
   if (!mtk_region_is_empty (state->surface_damage) ||
       !mtk_region_is_empty (state->buffer_damage))
     {
@@ -1082,7 +1219,7 @@ meta_wayland_surface_apply_state (MetaWaylandSurface      *surface,
                  surface_state_signals[SURFACE_STATE_SIGNAL_APPLIED],
                  0);
 
-  if (had_damage)
+  if (had_damage || mapping_changed)
     {
       MetaWindow *toplevel_window;
 
@@ -1094,7 +1231,18 @@ meta_wayland_surface_apply_state (MetaWaylandSurface      *surface,
           toplevel_window_actor =
             meta_window_actor_from_window (toplevel_window);
           if (toplevel_window_actor)
-            meta_window_actor_notify_damaged (toplevel_window_actor);
+            {
+              MtkRectangle bounds;
+              const MtkRectangle *known = NULL;
+
+              if (had_damage && !mapping_changed &&
+                  meta_window_actor_tracks_damage_bounds (toplevel_window_actor) &&
+                  get_toplevel_damage_bounds (surface, state,
+                                              toplevel_window_actor, &bounds))
+                known = &bounds;
+              meta_window_actor_notify_surface_update (toplevel_window_actor,
+                                                       had_damage, known);
+            }
         }
     }
 
